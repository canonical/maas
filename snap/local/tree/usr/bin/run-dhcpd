# GNU Affero General Public License version 3 (see the file LICENSE).

DHCP_DIR="$SNAP_COMMON/maas/dhcp"
DHCP_CONFIG="$SNAP_COMMON/maas/kea-dhcp4.conf"

if [ ! -e "$DHCP_CONFIG" ]; then
    echo "Cannot start dhcpd as $DHCP_CONFIG does not exist."
    exit 1
fi
# shellcheck disable=SC2086
export KEA_PIDFILE_DIR=$DHCP_DIR
export KEA_LOCKFILE_DIR=$DHCP_DIR
export KEA_LOG_FILE_DIR=$DHCP_DIR
export KEA_DHCP_DATA_DIR=$DHCP_DIR
export KEA_LFC_EXECUTABLE=${SNAP}/usr/sbin/kea-lfc
exec $SNAP/usr/sbin/kea-dhcp4 -c "$DHCP_CONFIG"
