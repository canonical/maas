export MAAS_PATH="$SNAP"
export MAAS_ROOT="$SNAP_DATA"
export MAAS_DATA="$SNAP_COMMON/maas"
export MAAS_OPENFGA_HTTP_SOCKET_PATH="$SNAP_DATA/openfga-http.sock"

# Set GODEBUG=fips140=on when the host kernel has FIPS mode enabled, so Go's
# crypto stack activates its FIPS-approved algorithms.  On non-FIPS hosts
# the variable is left unset and the binary behaves normally.
if [ -f /proc/sys/crypto/fips_enabled ] && \
   [ "$(cat /proc/sys/crypto/fips_enabled)" = "1" ]; then
    export GODEBUG="fips140=on"
fi

exec "$SNAP/usr/sbin/maas-openfga"
