server:
  disable: true

positions:
  filename: ${PROMTAIL_POS_DIR}/positions.yaml

clients:
  - url: ${LOKI_API_URL}

scrape_configs:
  - job_name: maas-audit
    syslog:
      listen_address: "127.0.0.1:${PROMTAIL_LISTEN_PORT:-5238}"
      labels:
        job: "maas-audit"
        host: ${HOSTNAME}

  - job_name: maas-console
    journal:
      matches: SYSLOG_IDENTIFIER=maas-regiond SYSLOG_IDENTIFIER=maas-rackd
      labels:
        host: ${HOSTNAME}
        job: "maas-console"

  - job_name: maas-dhcpd
    journal:
      matches: SYSLOG_IDENTIFIER=dhcpd SYSLOG_IDENTIFIER=dhcpd6
      labels:
        host: ${HOSTNAME}
        job: "maas-dhcpd"

  - job_name: maas-metadata
    journal:
      matches: SYSLOG_IDENTIFIER=maas-http
      labels:
        host: ${HOSTNAME}
        job: "maas-metadata"

  - job_name: maas-named
    journal:
      matches: SYSLOG_IDENTIFIER=named
      labels:
        host: ${HOSTNAME}
        job: "maas-named"

  - job_name: maas-ntpd
    journal:
      matches: SYSLOG_IDENTIFIER=chronyd
      labels:
        host: ${HOSTNAME}
        job: "maas-ntpd"

  - job_name: maas-proxy
    journal:
      matches: SYSLOG_IDENTIFIER=maas-proxy
      labels:
        host: ${HOSTNAME}
        job: "maas-proxy"
